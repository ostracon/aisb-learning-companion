# Configuration reference. The app does not load this file automatically.
# If you copy it to .env, export it in the shell before starting the app:
#   set -a
#   source .env
#   set +a

AISB_REPO_PATH=../aisb

# Optional overrides:
# AISB_COMPANION_STATE_PATH=/absolute/path/to/local-state
# AISB_COMPANION_ALLOW_TEMPORARY_STATE=true  # Disposable production tests only.
# PORT=7575

# Keep CODEX_OPENAI_API_KEY in your shell or secret manager, not in this file.
