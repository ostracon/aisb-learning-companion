{
  "name": "aisb-learning-companion",
  "version": "1.0.9",
  "description": "Local-first learning companion for the AI Security Bootcamp.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ostracon/aisb-learning-companion.git"
  },
  "homepage": "https://github.com/ostracon/aisb-learning-companion#readme",
  "bugs": {
    "url": "https://github.com/ostracon/aisb-learning-companion/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check:node": "node scripts/check-node.mjs",
    "check:codex-protocol": "node scripts/check-codex-protocol.mjs",
    "predev": "npm run check:node",
    "dev": "tsx watch src/server/index.ts",
    "prebuild": "npm run check:node",
    "build": "vite build && tsup src/server/index.ts --format esm --platform node --out-dir dist-server --sourcemap --external vite",
    "prestart": "npm run check:node",
    "start": "NODE_ENV=production node dist-server/index.js",
    "pretypecheck": "npm run check:node",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run check:node",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run tests/contract",
    "test:policy": "vitest run tests/unit/source-policy.test.ts",
    "test:live:codex": "vitest run tests/live",
    "test:production-start": "node scripts/smoke-production.mjs",
    "check": "npm run check:codex-protocol && npm run typecheck && npm test && npm run build && npm run test:production-start"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@fastify/middie": "9.3.3",
    "@fastify/static": "10.1.3",
    "@lezer/highlight": "1.2.3",
    "@openai/codex": "0.151.0",
    "@uiw/react-codemirror": "4.25.11",
    "fastify": "5.12.1",
    "highlight.js": "11.12.0",
    "katex": "0.16.47",
    "openai": "7.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.3",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/mdast": "4.0.4",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
